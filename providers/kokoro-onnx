#!/usr/bin/env bash
# desc: Best local quality, no torch. Fast to start.
# title: Kokoro (ONNX)
# kind: local
# probe: [[ -x "${KOKORO_ONNX_PYTHON:-${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro-onnx/bin/python}" && -s "${KOKORO_ONNX_MODELS:-${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro-onnx/models}/kokoro-v1.0.onnx" ]] && ( [[ -n "${KOKORO_ONNX_PYTHON:-}" ]] || [[ "$(cat "${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro-onnx/.lock-sha256" 2>/dev/null)" == "$(sha256sum "$TTS_PLUGIN_DIR/lib/engines/kokoro-onnx.lock" | cut -d' ' -f1)" ]] )
# install: managed Python 3.12 venv from lib/engines/kokoro-onnx.lock · verified model files
# voices: bundled
# ratemin: 0.5
# ratemax: 2.0
set -uo pipefail
umask 077
source "$TTS_PLUGIN_DIR/lib/play.sh"
source "$TTS_PLUGIN_DIR/lib/cache.sh"

KPY="${KOKORO_ONNX_PYTHON:-${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro-onnx/bin/python}"
if [[ ! -x "$KPY" ]]; then
  echo "speak: kokoro-onnx not installed." >&2
  echo "  Install it from the Provider tab." >&2
  notify-send -a "Speak" "Kokoro (ONNX) not installed" "See: speak --help" 2>/dev/null
  exit 127
fi

# An environment this release did not build from its shipped lock is not
# an installed engine, whatever it contains.
if [[ -z "${KOKORO_ONNX_PYTHON:-}" ]]; then
  ENGINE_DIR="${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro-onnx"
  if [[ "$(cat "$ENGINE_DIR/.lock-sha256" 2>/dev/null)" != "$(sha256sum "$TTS_PLUGIN_DIR/lib/engines/kokoro-onnx.lock" | cut -d' ' -f1)" ]]; then
    echo "speak: kokoro-onnx was installed by an earlier release; reinstall it from the Provider tab." >&2
    notify-send -a "Speak" "Kokoro (ONNX) needs reinstalling" "Reinstall it from the Provider tab." 2>/dev/null
    exit 127
  fi
fi

VOICE="${TTS_VOICE:-}"
[[ -z "$VOICE" ]] && VOICE="$(jq -r '.kokoro.voice // "af_heart"' "$TTS_CONFIG" 2>/dev/null)"
[[ -z "$VOICE" || "$VOICE" == "null" ]] && VOICE="af_heart"

# Same install-time trust as the PyTorch engine: the installer digested the
# graph and the voice-pack against lib/engines/models.json and published
# fingerprints; a key press only re-reads stat, and a missing, stale or
# unreadable record falls back to the full digests before anything loads.
MODELS="${KOKORO_ONNX_MODELS:-${TTS_DATA_DIR:-$HOME/.local/share/omarchy-tts}/engines/kokoro-onnx/models}"
MANIFEST="$TTS_PLUGIN_DIR/lib/engines/models.json"
ENGINE_DIR="$(dirname "$MODELS")"
RECORD="$ENGINE_DIR/.verified"
[[ "$VOICE" =~ ^[a-z]{2}_[a-z]+$ ]] || { echo "speak: kokoro-onnx: invalid voice name" >&2; exit 65; }

fingerprint() { # <file> — device, inode, size, nanosecond mtime as exact integers
  # Python's os.stat is the same primitive the installer uses to publish the
  # record, so the two sides agree by construction. GNU stat's %.9Y goes
  # through floating point and other coreutils implementations (uutils) do
  # too, which rounds differently and would make a valid record look stale.
  python3 - "$1" <<'KOKORO_FINGERPRINT_PY' 2>/dev/null
import os, sys
try:
    metadata = os.stat(sys.argv[1])
    seconds, nanoseconds = divmod(metadata.st_mtime_ns, 1_000_000_000)
    print(f"{metadata.st_dev}:{metadata.st_ino}:{metadata.st_size}:{seconds}.{nanoseconds:09d}")
except OSError:
    sys.exit(1)
KOKORO_FINGERPRINT_PY
}

record_fingerprints() { # see providers/kokoro; never follow a symlink here
  [[ -f "$RECORD" && ! -L "$RECORD" ]] || return 0
  jq -r '.files | to_entries[] | "\(.key)\t\(.value.fingerprint)"' "$RECORD" 2>/dev/null || true
}

record_dirty=0
verified_files=()
verify_model() { # <relative path>
  local want got matched recorded name_fp
  want="$(jq -r --arg f "$1" '.["kokoro-onnx"].files[$f].sha256 // empty' "$MANIFEST" 2>/dev/null)"
  [[ "$want" =~ ^[0-9a-f]{64}$ ]] || { echo "speak: kokoro-onnx: $1 is not a verified model file" >&2; exit 65; }
  [[ -f "$MODELS/$1" && ! -L "$MODELS/$1" ]] || { echo "speak: kokoro-onnx: $1 is missing; reinstall Kokoro (ONNX) from the Provider tab" >&2; exit 127; }
  matched=""
  while IFS=$'\t' read -r recorded name_fp; do
    if [[ "$recorded" == "$1" && "$name_fp" =~ ^[0-9]+:[0-9]+:[0-9]+:[0-9]+\.[0-9]{9}$ ]]; then
      matched="$name_fp"
    fi
  done < <(record_fingerprints)
  if [[ -n "$matched" && "$matched" == "$(fingerprint "$MODELS/$1")" ]]; then
    return 0
  fi
  record_dirty=1
  got="$(sha256sum "$MODELS/$1" 2>/dev/null | cut -d' ' -f1)"
  [[ "$got" == "$want" ]] || { echo "speak: kokoro-onnx: $1 failed verification; reinstall Kokoro (ONNX) from the Provider tab" >&2; exit 65; }
  verified_files+=("$1")
}

refresh_verification_record() {
  # Best effort, never fatal: republishing warms the next press; failing can
  # not fail the synthesis whose files just verified.
  local tmp
  tmp="$(mktemp "$ENGINE_DIR/.verified.tmp.XXXXXX")" || return 0
  MODELS="$MODELS" MANIFEST="$MANIFEST" RECORD="$RECORD" DEST="$tmp" KOKORO_VERIFIED="$(printf '%s\n' "${verified_files[@]}")" \
    python3 - <<'KOKORO_RECORD_PY' >/dev/null 2>&1 || { rm -f "$tmp"; return 0; }
import json, os, re, sys
try:
    with open(os.environ["MANIFEST"], encoding="utf-8") as source:
        manifest = json.load(source)["kokoro-onnx"]["files"]
    keep = {}
    record = os.environ["RECORD"]
    if os.path.isfile(record) and not os.path.islink(record) and os.stat(record).st_uid == os.getuid():
        with open(record, encoding="utf-8") as source:
            existing = json.load(source)
        if isinstance(existing, dict) and existing.get("version") == 1 and isinstance(existing.get("files"), dict):
            keep = existing["files"]
    refreshed = {}
    for name in [name for name in os.environ["KOKORO_VERIFIED"].split("\n") if name]:
        if not re.fullmatch(r"[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*\.(json|pth|pt|onnx|bin)", name):
            raise ValueError(name)
        digest = manifest[name]["sha256"]
        if not re.fullmatch(r"[0-9a-f]{64}", digest):
            raise ValueError(name)
        metadata = os.stat(os.path.join(os.environ["MODELS"], name))
        if metadata.st_uid != os.getuid():
            raise ValueError(name)
        seconds, nanoseconds = divmod(metadata.st_mtime_ns, 1_000_000_000)
        refreshed[name] = {"sha256": digest,
                           "fingerprint": f"{metadata.st_dev}:{metadata.st_ino}:{metadata.st_size}:{seconds}.{nanoseconds:09d}"}
    out = {"version": 1, "files": {**keep, **refreshed}}
    descriptor = os.open(os.environ["DEST"], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(descriptor, (json.dumps(out, sort_keys=True) + "\n").encode())
    finally:
        os.close(descriptor)
except Exception:
    sys.exit(1)
KOKORO_RECORD_PY
  [[ -s "$tmp" ]] || { rm -f "$tmp"; return 0; }
  chmod 600 "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  mv -f "$tmp" "$RECORD" 2>/dev/null || rm -f "$tmp"
}

verify_model kokoro-v1.0.onnx
verify_model voices-v1.0.bin
if [[ "$record_dirty" == 1 && "${#verified_files[@]}" -gt 0 ]]; then
  refresh_verification_record
fi

# Same text stash as providers/kokoro: cache keying and both synthesis paths
# must see the identical bytes.
RATE="${TTS_RATE:-1.0}"
TEXT_FILE="$(mktemp "${TMPDIR:-/tmp}/omarchy-tts-text.XXXXXXXX")"
PCM_STAGE=""
# Installed via trap, never called directly; shellcheck would flag SC2329.
# shellcheck disable=SC2329
rm_text() { rm -f -- "$TEXT_FILE" "$PCM_STAGE"; }
trap rm_text EXIT
cat > "$TEXT_FILE"

CK=""
if audio_cache_enabled; then
  CK="$(audio_cache_key kokoro-onnx "$VOICE" "$RATE" < "$TEXT_FILE")"
  if CACHED="$(audio_cache_lookup kokoro-onnx "$CK")"; then
    rm -f -- "$TEXT_FILE"
    # play_raw takes over this process (it execs the player), so the trap is
    # moot here: everything was removed above by hand.
    play_raw 24000 1 < "$CACHED"
  fi
  PCM_STAGE="$(audio_cache_stage kokoro-onnx "$CK")"
fi

# Same resident-daemon fast path as providers/kokoro: verification ran above
# either way, and any failure before the first audio byte falls through to
# the inline synthesis below. See that file for the full rationale.
daemon_socket() { # <unit-name> — where the daemon or systemd listens
  if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    printf '%s/omarchy-tts/%s.sock' "$XDG_RUNTIME_DIR" "$1"
  else
    printf '%s/omarchy-tts/run/%s.sock' "${XDG_STATE_HOME:-$HOME/.local/state}" "$1"
  fi
}

try_daemon() { # try_daemon <unit-name> — 3 means "not served, fall back"
  [[ "${TTS_DAEMON:-1}" == "1" ]] || return 3
  # A hand-supplied interpreter belongs to --verify and experiments: the
  # daemon serves only what this release installed, so never divert to it.
  [[ -z "${KOKORO_ONNX_PYTHON:-}" ]] || return 3
  local sock header
  sock="$(daemon_socket "$1")"
  [[ -S "$sock" ]] || return 3
  header="$(jq -cRs --arg voice "$VOICE" --arg speed "$RATE" \
               '{voice:$voice, speed:($speed|tonumber), text:.}' < "$TEXT_FILE")" || return 3
  [[ "$header" == '{'* ]] || return 3
  HEADER_JSON="$header" SOCK_PATH="$sock" python3 - <<'DAEMON_CLIENT_PY'
import os, socket, sys
try:
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(30.0)
    sock.connect(os.environ["SOCK_PATH"])
    sock.sendall(os.environ["HEADER_JSON"].encode() + b"\n")
except OSError:
    sys.exit(3)  # not served: the inline path still runs
total = 0
try:
    while True:
        chunk = sock.recv(65536)
        if not chunk:
            break
        total += len(chunk)
        sys.stdout.buffer.write(chunk)
except OSError:
    pass  # the press was interrupted; the daemon learns from the broken pipe
try:
    sys.stdout.buffer.flush()
except OSError:
    pass
# An empty reply means the daemon refused the request: fall back and let the
# inline path produce the real voice/speed error instead of guessing here.
sys.exit(0 if total else 3)
DAEMON_CLIENT_PY
}

# The voice name is the G2P language too: Kokoro voice ids are prefixed by
# their language (af = American English, bf = British, ef = Spanish, zz etc.),
# so phonemization never guesses and never downloads a language pack.
case "$VOICE" in
  a*) LANG_G2P="en-us" ;;
  b*) LANG_G2P="en-gb" ;;
  e*) LANG_G2P="es"    ;;
  f*) LANG_G2P="fr-fr" ;;
  h*) LANG_G2P="hi"    ;;
  i*) LANG_G2P="it"    ;;
  j*) LANG_G2P="ja"    ;;
  p*) LANG_G2P="pt-br" ;;
  z*) LANG_G2P="zh"    ;;
  *)   echo "speak: kokoro-onnx: unknown voice language for $VOICE" >&2; exit 65 ;;
esac

# The inline synthesis stage: tee into the cache stage when caching, else
# pass bytes through untouched.
inline_stage() {
  if [[ -n "$PCM_STAGE" ]]; then
    tee -- "$PCM_STAGE"
  else
    cat
  fi
}

if [[ -n "$PCM_STAGE" ]]; then
  if try_daemon kokoro-onnx | tee -- "$PCM_STAGE" | play_raw 24000 1; then
    # Served completely: the staged bytes become the cache entry.
    audio_cache_commit kokoro-onnx "$CK" "$PCM_STAGE"
    exit 0
  fi
  # Not served, or the press died partway: fall through to the inline path.
else
  if try_daemon kokoro-onnx | play_raw 24000 1; then
    exit 0
  fi
fi

KOKORO_ONNX_VOICE="$VOICE" KOKORO_ONNX_LANG="$LANG_G2P" KOKORO_SPEED="$RATE" KOKORO_MODELS="$MODELS" \
PYTHONWARNINGS=ignore \
"$KPY" 3<"$TEXT_FILE" - <<'KOKORO_ONNX_PY' 2>/dev/null | inline_stage | play_raw 24000 1
import asyncio, os, sys, warnings
warnings.filterwarnings("ignore")
import numpy as np
from kokoro_onnx import Kokoro

models = os.environ["KOKORO_MODELS"]
voice = os.environ.get("KOKORO_ONNX_VOICE", "af_heart")
lang = os.environ.get("KOKORO_ONNX_LANG", "en-us")
speed = float(os.environ.get("KOKORO_SPEED", "1.0"))
# Local, verified files only: no repo lookup, no hub download.
synth = Kokoro(os.path.join(models, "kokoro-v1.0.onnx"),
               os.path.join(models, "voices-v1.0.bin"))
if voice not in synth.get_voices():
    sys.stderr.write(f"speak: kokoro-onnx: unknown voice {voice}\n")
    sys.exit(65)
with os.fdopen(3, encoding="utf-8") as source:
    text = source.read()

async def speak():
    # One synthesized batch to stdout at a time: the same chunked contract the
    # other providers share, so playback starts on the first batch.
    async for samples, _rate in synth.create_stream(text, voice=voice, speed=speed, lang=lang):
        audio = np.clip(np.asarray(samples, dtype="float32"), -1.0, 1.0)
        sys.stdout.buffer.write((audio * 32767.0).astype("<i2").tobytes())
        sys.stdout.buffer.flush()

asyncio.run(speak())
KOKORO_ONNX_PY
inline_rc=$?
if (( inline_rc == 0 )) && [[ -n "$PCM_STAGE" ]]; then
  audio_cache_commit kokoro-onnx "$CK" "$PCM_STAGE"
fi
exit "$inline_rc"