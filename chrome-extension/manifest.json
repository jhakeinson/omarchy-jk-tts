{
  "manifest_version": 3,
  "name": "Omarchy TTS Reader",
  "version": "0.1.0",
  "description": "Read page selections aloud with the local Omarchy TTS bridge.",
  "minimum_chrome_version": "105",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Omarchy TTS Reader",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Read the current selection aloud"
    },
    "stop-reading": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Stop reading"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume reading"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      }
    }
  }
}
